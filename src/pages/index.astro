---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to THE10">
    <section class="hero" id="home">
        <h1>THE10 - Youth Excellence Center</h1>
        <p class="tagline">Youth. Excellence. You.</p>
        <p class="mission">Youth entrepreneurship and excellence with yogic powers - Samyama, Yama and Niyama.</p>
    </section>

    <section class="why-evolution" id="why">
        <h2>The 10 YEC Purpose</h2>
        <div class="why-container">
            <div class="why-row">
                <div class="number-circle">1</div>
                <div class="why-text">
                    <h3>Mind has become the strongest link!</h3>
                    <p>Restore the "human" super power with Samyama</p>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* Add section-specific styles here */
    .hero { background: var(--gold); padding: 80px 5%; text-align: center; color: var(--navy); }
    .hero h1 { font-size: 2.5rem; text-transform: uppercase; }
    /* ... keep the rest of your CSS for sections here ... */
</style>